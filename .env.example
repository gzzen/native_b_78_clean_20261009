# Path: .env.example
# Purpose: Template for project-local, host-only model credentials.
# Copy to .env, fill in the key for the provider you run, and keep .env private (chmod 600 .env).
# Exported variables take precedence over this file.
DEEPSEEK_API_KEY=
# OpenAI Responses relay (models openai-relay/gpt-*). Use a relay-specific key;
# OPENAI_API_KEY is deliberately never read or sent to the relay.
OPENAI_RELAY_API_KEY=
# OPENAI_RELAY_BASE_URL=https://xfastapi.ai
